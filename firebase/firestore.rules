rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/settings/admins)
        && request.auth.token.email in get(/databases/$(database)/documents/settings/admins).data.emails;
    }

    match /settings/admins {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.token.email in request.resource.data.emails;
      allow update: if isAdmin()
        && request.auth.token.email in request.resource.data.emails;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId);

      match /subscriptions/{id} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }

      match /transactions/{id} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId);
      }
    }

    match /{path=**}/subscriptions/{id} {
      allow read: if isAdmin();
    }

    match /{path=**}/transactions/{id} {
      allow read: if isAdmin();
    }
  }
}
